dunjiatianshuCard = sgs.CreateSkillCard{
    name = "dunjiatianshuCard",
    target_fixed = true,
    on_use = function(self, room, source, targets)
        if source:isAlive() and source:hasTreasure("dunjiatianshu") and source:canTransform() then
            room:setPlayerFlag(source, "dunjiatianshu_transform")
            room:transformDeputyGeneral(source)
            room:setPlayerFlag(source, "-dunjiatianshu_transform")
        end
    end,
}

dunjiatianshu_skill = sgs.CreateZeroCardViewAsSkill{
    name = "dunjiatianshu_skill",
    view_as = function(self)
        local card = dunjiatianshuCard:clone()
        card:setSkillName("dunjiatianshu")
        return card
    end,
    enabled_at_play = function(self, player)
        return player:hasTreasure("dunjiatianshu") and player:canTransform()
            and player:usedTimes("#dunjiatianshuCard") < 2
    end,
}

dunjiatianshu_transform = sgs.CreateTriggerSkill{
    name = "#dunjiatianshu-transform",
    global = true,
    priority = -10,
    events = {sgs.GeneralTransforming},
    can_trigger = function(self, event, room, player, data)
        if player and player:hasFlag("dunjiatianshu_transform") then return self:objectName() end
        return ""
    end,
    on_cost = function(self, event, room, player, data)
        return true
    end,
    on_effect = function(self, event, room, player, data)
        -- 与荐才相同的数量接口，在增加备选数量的技能之后固定为一张。
        data:setValue(1)
        return false
    end,
}

zhanshejian = sgs.CreateWeapon{
    name = "zhanshejian",
    class_name = "zhanshejian",
    suit = sgs.Card_Spade,
    number = 1,
    range = 2,
}

zhanshejian_skill = sgs.CreateTriggerSkill{
    name = "zhanshejian_skill",
    global = true,
    events = {sgs.Damage},
    can_trigger = function(self, event, room, player, data)
        if not (player and player:isAlive() and player:hasWeapon("zhanshejian")) then return "" end
        local damage = data:toDamage()
        if damage.from == player and damage.card and damage.card:isKindOf("Slash")
            and not damage.chain and not damage.transfer then return self:objectName() end
        return ""
    end,
    on_cost = function(self, event, room, player, data)
        return true
    end,
    on_effect = function(self, event, room, player, data)
        local damage = data:toDamage()
        local target = damage.to
        -- 先固定身份判断，避免回复体力插入的结算改变本次效果。
        local execute = target and (target:getRole() == "careerist"
            or (target:getGeneral() and target:getGeneral():isLord()))
        if player:isWounded() then
            local recover = sgs.RecoverStruct()
            recover.who, recover.recover = player, 1
            room:recover(player, recover)
        end
        if execute and target:isAlive() then
            -- 直接死亡，保留本次杀的伤害来源以正常处理击杀奖惩。
            room:killPlayer(target, damage)
        end
        return false
    end,
}

