extension = sgs.Package("jiubianEquip", sgs.Package_CardPack)
local skills = sgs.SkillList()

yangsuiqiang = sgs.CreateWeapon{
    name = "yangsuiqiang",
    class_name = "yangsuiqiang",
    suit = sgs.Card_Diamond,
    number = 11,
    range = 3,
}

yangsuiqiang_skill = sgs.CreateTriggerSkill{
    name = "yangsuiqiang_skill",
    global = true,
    frequency = sgs.Skill_Compulsory,
    events = {sgs.Damage},
    can_trigger = function(self, event, room, player, data)
        if not (player and player:isAlive() and player:hasWeapon("yangsuiqiang")) then
            return ""
        end
        local damage = data:toDamage()
        if damage.from == player and damage.to and damage.to:isAlive()
            and damage.card and damage.card:isKindOf("Slash")
            and not damage.chain and not damage.transfer then
            return self:objectName()
        end
        return ""
    end,
    on_cost = function(self, event, room, player, data)
        return true
    end,
    on_effect = function(self, event, room, player, data)
        local target = data:toDamage().to
        if target and target:isAlive() then
            local damage = sgs.DamageStruct()
            damage.to = target
            damage.damage = 1
            damage.nature = sgs.DamageStruct_Fire
            damage.reason = "yangsuiqiang"
            -- 不设置 from 和 card：这是独立的无来源火焰伤害。
            room:damage(damage)
        end
        return false
    end,
}

huohuanyi = sgs.CreateArmor{
    name = "huohuanyi",
    class_name = "huohuanyi",
    suit = sgs.Card_Diamond,
    number = 12,
}

huohuanyi_skill = sgs.CreateTriggerSkill{
    name = "huohuanyi_skill",
    global = true,
    events = {sgs.DamageInflicted, sgs.TargetConfirmed},
    can_trigger = function(self, event, room, player, data)
        if not (player and player:isAlive() and player:hasArmorEffect("huohuanyi")) then
            return ""
        end
        if event == sgs.DamageInflicted then
            if data:toDamage().nature ~= sgs.DamageStruct_Normal then return self:objectName() end
        else
            local use = data:toCardUse()
            if use.card and use.card:isKindOf("Slash") and use.to:contains(player)
                and use.from and use.from:isAlive() and player:canDiscard(player, "h") then
                return self:objectName()
            end
        end
        return ""
    end,
    on_cost = function(self, event, room, player, data)
        if event == sgs.DamageInflicted then return true end
        return room:askForDiscard(player, "huohuanyi", 1, 1, true, false,
            "@huohuanyi-discard:" .. data:toCardUse().from:objectName())
    end,
    on_effect = function(self, event, room, player, data)
        if event == sgs.DamageInflicted then return true end
        local source = data:toCardUse().from
        if source and source:isAlive() then
            local damage = sgs.DamageStruct()
            damage.from, damage.to = player, source
            damage.damage = 1
            damage.nature = sgs.DamageStruct_Fire
            damage.reason = "huohuanyi"
            room:damage(damage)
        end
        return false
    end,
}

baiqilin = sgs.DefensiveHorse(sgs.Card_Heart, 2, 2)--花色，点数，距离修正
baiqilin:setObjectName("baiqilin")

baiqilin_skill = sgs.CreateTriggerSkill{
    name = "baiqilin_skill",
    global = true,
    frequency = sgs.Skill_Compulsory,
    events = {sgs.CardUsed},
    can_trigger = function(self, event, room, player, data)
        local use = data:toCardUse()
        if use.card and use.card:objectName() == "baiqilin"
            and use.from and use.from:isAlive() then
            return self:objectName(), use.from:objectName()
        end
        return ""
    end,
    on_cost = function(self, event, room, player, data, ask_who)
        return true
    end,
    on_effect = function(self, event, room, player, data, ask_who)
        local targets = sgs.SPlayerList()
        for _, target in sgs.qlist(room:getOtherPlayers(ask_who)) do
            if target:getHp() > ask_who:getHp() then targets:append(target) end
        end
        room:sortByActionOrder(targets)
        for _, target in sgs.qlist(targets) do
            if target:isAlive() then
                local damage = sgs.DamageStruct()
                damage.from, damage.to = ask_who, target
                damage.damage = 1
                damage.nature = sgs.DamageStruct_Thunder
                damage.reason = "baiqilin"
                room:damage(damage)
            end
        end
        return false
    end,
}

yingwubei = sgs.CreateTreasure{
    name = "yingwubei",
    class_name = "yingwubei",
    suit = sgs.Card_Heart,
    number = 9,
    on_install = function(self, player)
        player:getRoom():attachSkillToPlayer(player, "yingwubei_skill")
    end,
    on_uninstall = function(self, player)
        player:getRoom():detachSkillFromPlayer(player, "yingwubei_skill", true)
    end,
}

yingwubei_skill = sgs.CreateZeroCardViewAsSkill{
    name = "yingwubei_skill",
    response_or_use = true,
    view_as = function(self)
        local card = sgs.Sanguosha:cloneCard("analeptic")
        card:setSkillName("yingwubei")
        return card
    end,
    enabled_at_play = function(self, player)
        if not player:hasTreasure("yingwubei") or player:getMark("yingwubei_used") >= 9 then return false end
        local card = sgs.Sanguosha:cloneCard("analeptic")
        card:setSkillName("yingwubei")
        local available = card:isAvailable(player)
        card:deleteLater()
        return available
    end,
    enabled_at_response = function(self, player, pattern)
        return player:hasTreasure("yingwubei") and player:getMark("yingwubei_used") < 9 and string.find(pattern, "analeptic")
    end,
}

yingwubei_record = sgs.CreateTriggerSkill{
    name = "#yingwubei-record",
    global = true,
    events = {sgs.TurnStart, sgs.PreCardUsed, sgs.CardResponded},
    on_record = function(self, event, room, player, data)
        if event == sgs.TurnStart then
            for _, target in sgs.qlist(room:getAllPlayers(true)) do
                room:setPlayerMark(target, "yingwubei_used", 0)
            end
            return
        end
        local card, source
        if event == sgs.PreCardUsed then
            local use = data:toCardUse()
            card, source = use.card, use.from
        else
            local response = data:toCardResponse()
            if not response.m_isUse then return end
            card, source = response.m_card, player
        end
        if not (card and source and card:isKindOf("Analeptic")
            and card:getSkillName() == "yingwubei") then return end
        -- 兼容同一次使用同时通知使用和响应事件的客户端。
        if card:hasFlag("yingwubei_paid") then return end
        card:setFlags("yingwubei_paid")
        room:addPlayerMark(source, "yingwubei_used", 1)
        local ids = room:getNCards(1, false)
        if ids:isEmpty() then return end
        local reason = sgs.CardMoveReason(sgs.CardMoveReason_S_REASON_NATURAL_ENTER,
            source:objectName(), "yingwubei", "")
        room:throwCard(sgs.Sanguosha:getCard(ids:first()), reason, nil)
    end,
    can_trigger = function(self, event, room, player, data)
        return ""
    end,
}

